<?xml version="1.0" encoding="UTF-8"?>

<!--
    项目唯一入口 — Jetty 启动时最先读取这个文件

    全部启动流程：
      Jetty 读取 web.xml
        → 实例化 DispatcherServlet
        → DispatcherServlet 读取 init-param: contextClass（纯注解模式，不用 applicationContext.xml）
        → DispatcherServlet 读取 init-param: contextConfigLocation = WebConfig
        → WebConfig 上的 @ComponentScan("com.example.stage3") 扫描所有 @Controller/@Service/@Repository/@Aspect
        → 完成所有 Bean 的创建和依赖注入
        → 服务就绪，监听 8081 端口
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>java-web-stage3-demo</display-name>

    <!-- ========== Spring MVC 核心：DispatcherServlet ========== -->
    <servlet>
        <servlet-name>dispatcher</servlet-name>
        <!-- Spring MVC 的核心调度器，所有请求（"/" 路径下）都经过它 -->
        <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>

        <init-param>
            <!-- 使用纯注解方式加载 Spring 上下文，不需要 XML 配置 -->
            <param-name>contextClass</param-name>
            <param-value>org.springframework.web.context.support.AnnotationConfigWebApplicationContext</param-value>
        </init-param>

        <init-param>
            <!-- 指定 Spring 配置类，替代传统 spring-servlet.xml -->
            <param-name>contextConfigLocation</param-name>
            <param-value>com.example.stage3.config.WebConfig</param-value>
        </init-param>

        <!-- load-on-startup=1：启动时立刻初始化（而不是等第一个请求才初始化）
             值越小优先级越高，0 留给根上下文（如果有） -->
        <load-on-startup>1</load-on-startup>
    </servlet>

    <!-- 将 DispatcherServlet 映射到根路径 "/"，拦截所有请求 -->
    <servlet-mapping>
        <servlet-name>dispatcher</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>

</web-app>
