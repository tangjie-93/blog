{
  "name": "tangjie-blog",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "type": "module",
  "description": "前端技术积累：VitePress 技术博客",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs && node scripts/check-build.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "pnpm run build",
    "docs:preview": "vitepress preview docs",
    "deploy": "pnpm run docs:build && wrangler pages deploy docs/.vitepress/dist --project-name tangjie-blog",
    "test": "node --test tests/*.test.mjs docs/.vitepress/theme/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"]
  },
  "dependencies": {
    "leancloud-storage": "^4.15.2",
    "valine": "1.5.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitepress": "1.6.4",
    "wrangler": "4.149.0"
  },
  "license": "ISC"
}
